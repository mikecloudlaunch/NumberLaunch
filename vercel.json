{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "build-vercel.js",
      "use": "@vercel/node",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { 
      "src": "/api(.*)", 
      "dest": "/api/index.js" 
    },
    {
      "handle": "filesystem"
    },
    { 
      "src": "/(.*)", 
      "dest": "/api/index.js" 
    }
  ],
  "github": {
    "silent": false
  },
  "env": {
    "NODE_ENV": "production"
  }
}
