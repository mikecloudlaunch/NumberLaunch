{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "routes": [
    { 
      "src": "/api/(.*)", 
      "dest": "/api/index.js" 
    },
    {
      "handle": "filesystem"
    },
    { 
      "src": "/(.*)", 
      "dest": "/index.html" 
    }
  ],
  "github": {
    "silent": false,
    "autoJobCancelation": false,
    "enabled": true
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "NL": true
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
